  temperature        Decimal?  @default(0.50) @db.Decimal(3, 2)
  maxTokens          Int?      @default(8000) @map("max_tokens")
  timeoutMs          Int?      @default(120000) @map("timeout_ms")
  requireErrorMarks  Boolean?  @default(true) @map("require_error_marks")
  minErrorMarksCount Int?      @default(1) @map("min_error_marks_count")
  minCoverageRate    Decimal?  @default(0.30) @map("min_coverage_rate") @db.Decimal(3, 2)
  strictValidation   Boolean?  @default(true) @map("strict_validation")
  createdBy          String?   @map("created_by") @db.VarChar(50)
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at")
  comment            String?   @db.Text

  logs AiReviewLog[]

  @@unique([name, version], map: "uk_name_version")
  @@index([isActive], map: "idx_active")
  @@index([createdAt], map: "idx_created_at")
  @@map("ai_review_strategies")
}

model AiReviewLog {
  id                 BigInt    @id @default(autoincrement())
  recordId           String    @map("record_id") @db.VarChar(50)
  questionId         String    @map("question_id") @db.VarChar(50)
  subQuestionId      String?   @map("sub_question_id") @db.VarChar(50)
  strategyId         Int?      @map("strategy_id")
  strategyName       String?   @map("strategy_name") @db.VarChar(100)
  strategyVersion    String?   @map("strategy_version") @db.VarChar(20)
  model              String?   @db.VarChar(50)
  temperature        Decimal?  @db.Decimal(3, 2)
  promptTokens       Int?      @map("prompt_tokens")
  completionTokens   Int?      @map("completion_tokens")
  totalTokens        Int?      @map("total_tokens")
  latencyMs          Int?      @map("latency_ms")
  status             String?   @db.VarChar(50)
  retryCount         Int?      @default(0) @map("retry_count")
  errorMessage       String?   @map("error_message") @db.Text
  validationPassed   Boolean?  @map("validation_passed")
  validationErrors   Json?     @map("validation_errors")
  score              Int?
  maxScore           Int?      @map("max_score")
  positiveMarksCount Int?      @map("positive_marks_count")
  errorMarksCount    Int?      @map("error_marks_count")
  neutralMarksCount  Int?      @map("neutral_marks_count")
  coverageRate       Decimal?  @map("coverage_rate") @db.Decimal(4, 3)
  commentLength      Int?      @map("comment_length")
  startedAt          DateTime? @map("started_at") @db.DateTime(3)
  completedAt        DateTime? @map("completed_at") @db.DateTime(3)
  rawPrompt          String?   @map("raw_prompt") @db.MediumText
  rawResponse        String?   @map("raw_response") @db.MediumText
  finalResult        Json?     @map("final_result")

  strategy AiReviewStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([recordId], map: "idx_record")
  @@index([questionId], map: "idx_question")
  @@index([status], map: "idx_status")
  @@index([startedAt], map: "idx_started_at")
  @@index([strategyId], map: "idx_strategy")
  @@map("ai_review_logs")
}

