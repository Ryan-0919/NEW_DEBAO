generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  active
  disabled
}

enum CourseContentType {
  audio
  video
}

enum CourseStatus {
  open
  closed
  scheduled
}

enum AudioProcessStatus {
  pending
  processing
  ready
  failed
}

enum MockExamPaperStatus {
  draft
  published
}

enum LawPracticePaperStatus {
  draft
  published
}

enum DictationItemStatus {
  draft
  published
}

enum RecitationItemStatus {
  draft
  published
}

enum MockExamQuestionType {
  single_choice
  multiple_choice
  uncertain_choice
  subjective_case
}

enum QuestionBankPaperType {
  objective
  subjective
}

enum BookQuestionBankStatus {
  draft
  published
  closed
}

enum BookQuestionBankAccessType {
  public
  authorized
}

enum MockExamRecordStatus {
  in_progress
  submitted
}

enum MockExamReviewWorkflowStatus {
  not_required
  ai_pending
  ai_processing
  manual_pending
  published
  returned_for_redo
}

enum TypingPracticeTextStatus {
  draft
  published
}

enum TypingPracticeDifficulty {
  easy
  medium
  hard
}

enum TypingPracticeMode {
  guided
  sprint
  memorize
}

enum ShopProductType {
  virtual
  physical
  hybrid
}

enum ShopProductStatus {
  draft
  on_sale
  off_sale
}

enum ShopOrderStatus {
  pending_payment
  paid
  partially_fulfilled
  completed
  cancelled
  refunding
  refunded
}

enum ShopPaymentStatus {
  unpaid
  paid
  failed
  refunded
}

enum ShopDigitalFulfillmentStatus {
  pending
  success
  failed
}

enum ShopShipmentStatus {
  pending
  shipped
  in_transit
  signed
  failed
}

enum ShopRefundStatus {
  pending
  approved
  rejected
  completed
  failed
}

enum ShopBannerLinkType {
  product
  category
  custom
}

enum UserRegistrationSource {
  legacy_unknown
  self_register
  sms_auto_created
  admin_created
  admin_imported
}

model Admin {
  id           String     @id @default(cuid())
  account      String     @unique @db.VarChar(50)
  passwordHash String     @db.VarChar(255)
  name         String     @db.VarChar(100)
  role         String     @default("super_admin") @db.VarChar(50)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model User {
  id                          String                           @id @default(cuid())
  phone                       String                           @unique @db.VarChar(20)
  nickname                    String?                          @db.VarChar(100)
  avatarUrl                   String?                          @db.VarChar(500)
  avatarObjectKey             String?                          @db.VarChar(255)
  passwordHash                String                           @db.VarChar(255)
  status                      UserStatus                       @default(active)
  registrationSource          UserRegistrationSource           @default(legacy_unknown)
  registeredAt                DateTime                         @default(now())
  lastLoginAt                 DateTime?
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  permissions                 UserCoursePermission[]
  devices                     UserDevice[]
  progresses                  UserProgress[]
  videoProgresses             UserVideoProgress[]
  courseNotes                 UserCourseNote[]
  videoDanmakus               VideoDanmaku[]
  addresses                   UserAddress[]
  cartItems                   ShopCartItem[]
  shopOrders                  ShopOrder[]
  digitalFulfillments         ShopDigitalFulfillment[]
  mockExamRecords             MockExamRecord[]
  mockExamPermissions         UserMockExamPermission[]
  mockExamSeriesPermissions   UserMockExamSeriesPermission[]
  mockExamLeaderboardEntries  MockExamLeaderboardEntry[]
  bookQuestionBankPermissions UserBookQuestionBankPermission[]
  bookQuestionBankProgresses  UserBookQuestionBankProgress[]
  bookQuestionBankItemStates  UserBookQuestionBankItemState[]
  typingPracticeRecords       TypingPracticeRecord[]
  lawPracticeRecords          LawPracticeRecord[]
}

model UserDevice {
  id        String   @id @default(cuid())
  userId    String
  deviceKey String   @db.VarChar(191)
  type      String   @db.VarChar(50)
  model     String   @db.VarChar(100)
  ip        String   @db.VarChar(64)
  loginAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceKey])
  @@index([userId])
}

model SmsVerificationCode {
  id             String    @id @default(cuid())
  phone          String    @db.VarChar(20)
  scene          String    @default("login") @db.VarChar(30)
  codeHash       String    @db.VarChar(128)
  expiresAt      DateTime
  consumedAt     DateTime?
  sendIp         String    @db.VarChar(64)
  sendStatus     String    @default("pending") @db.VarChar(20)
  bizId          String?   @db.VarChar(100)
  requestId      String?   @db.VarChar(100)
  errorMessage   String?   @db.VarChar(255)
  verifyAttempts Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([phone, scene, createdAt])
  @@index([expiresAt])
  @@index([sendStatus, createdAt])
}

model Course {
  id                String                 @id @default(cuid())
  name              String                 @db.VarChar(191)
  coverUrl          String                 @db.VarChar(500)
  coverObjectKey    String?                @db.VarChar(255)
  handoutUrl        String?                @db.VarChar(500)
  handoutObjectKey  String?                @db.VarChar(255)
  handoutName       String?                @db.VarChar(255)
  description       String                 @db.LongText
  courseType        CourseContentType      @default(audio)
  status            CourseStatus           @default(closed)
  isPublic          Boolean                @default(false)
  openTime          DateTime
  sortOrder         Int                    @default(0)
  openedAt          DateTime?
  webhookNotifiedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tags              Tag[]
  permissions       UserCoursePermission[]
  notes             UserCourseNote[]
  videoDanmakus     VideoDanmaku[]
  courseAudios      CourseAudio[]
  courseVideos      CourseVideo[]
  shopProducts      ShopProductCourse[]

  @@index([courseType, status, openTime])
  @@index([isPublic, status, openTime])
  @@index([status, openTime])
}

model Tag {
  id           String        @id @default(cuid())
  courseId     String
  name         String        @db.VarChar(100)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseAudios CourseAudio[]
  courseVideos CourseVideo[]

  @@unique([courseId, name])
  @@index([courseId, order])
}

model AudioFolder {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audios    Audio[]
}

model Audio {
  id               String             @id @default(cuid())
  name             String             @db.VarChar(191)
  folderId         String
  duration         Int                @default(0)
  scriptText       String?            @db.LongText
  handoutUrl       String?            @db.VarChar(500)
  handoutObjectKey String?            @db.VarChar(255)
  handoutName      String?            @db.VarChar(255)
  objectKey        String?            @unique @db.VarChar(255)
  objectUrl        String?            @db.VarChar(500)
  mimeType         String?            @db.VarChar(100)
  processStatus    AudioProcessStatus @default(pending)
  processMessage   String?            @db.VarChar(500)
  uploadedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  folder           AudioFolder        @relation(fields: [folderId], references: [id], onDelete: Restrict)
  courseAudios     CourseAudio[]
  progresses       UserProgress[]

  @@index([folderId, uploadedAt])
  @@index([processStatus, uploadedAt])
}

model VideoFolder {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]
}

model Video {
  id               String              @id @default(cuid())
  name             String              @db.VarChar(191)
  folderId         String
  duration         Int                 @default(0)
  scriptText       String?             @db.LongText
  handoutUrl       String?             @db.VarChar(500)
  handoutObjectKey String?             @db.VarChar(255)
  handoutName      String?             @db.VarChar(255)
  objectKey        String?             @unique @db.VarChar(255)
  objectUrl        String?             @db.VarChar(500)
  mimeType         String?             @db.VarChar(100)
  processStatus    AudioProcessStatus  @default(ready)
  processMessage   String?             @db.VarChar(500)
  uploadedAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  folder           VideoFolder         @relation(fields: [folderId], references: [id], onDelete: Restrict)
  courseVideos     CourseVideo[]
  progresses       UserVideoProgress[]
  danmakus         VideoDanmaku[]

  @@index([folderId, uploadedAt])
  @@index([processStatus, uploadedAt])
}

model CourseAudio {
  id        String   @id @default(cuid())
  courseId  String
  tagId     String
  audioId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  audio     Audio    @relation(fields: [audioId], references: [id], onDelete: Restrict)

  @@unique([courseId, audioId])
  @@index([tagId, order])
  @@index([courseId])
  @@index([audioId])
}

model CourseVideo {
  id        String   @id @default(cuid())
  courseId  String
  tagId     String
  videoId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@unique([courseId, videoId])
  @@index([tagId, order])
  @@index([courseId])
  @@index([videoId])
}

model UserCoursePermission {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  audioId     String
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  lastUpdated DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audio       Audio    @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, audioId])
  @@index([courseId])
  @@index([audioId])
}

model UserVideoProgress {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  videoId      String
  progress     Int      @default(0)
  lastPosition Int      @default(0)
  completed    Boolean  @default(false)
  lastUpdated  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, videoId])
  @@index([courseId])
  @@index([videoId])
}

model VideoDanmaku {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  videoId     String
  timeSeconds Int      @default(0)
  content     String   @db.VarChar(120)
  color       String?  @db.VarChar(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([courseId, videoId, timeSeconds])
  @@index([userId, createdAt])
}

model UserCourseNote {
  id        String            @id @default(cuid())
  userId    String
  courseId  String
  mediaType CourseContentType
  mediaId   String            @db.VarChar(191)
  content   String            @db.LongText
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, mediaType, mediaId])
  @@index([courseId, mediaType, mediaId])
  @@index([userId, updatedAt])
}

model SystemConfig {
  id                                 Int      @id @default(1)
  webhookUrl                         String?  @db.VarChar(500)
  brandLogoUrl                       String?  @db.VarChar(500)
  brandLogoObjectKey                 String?  @db.VarChar(255)
  playerDiscImageUrl                 String?  @db.VarChar(500)
  customerServiceUrl                 String?  @db.VarChar(500)
  portalConfigJson                   String?  @db.LongText
  smsConfigJson                      String?  @db.LongText
  mockExamAiReviewConfigJson         String?  @db.LongText
  mockExamLaunchConfigJson           String?  @db.LongText
  typingPracticeDifficultyConfigJson String?  @db.LongText
  typingPracticeHomeConfigJson       String?  @db.LongText
  playerDiscImageObjectKey           String?  @db.VarChar(255)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt
}

enum WebhookLogStatus {
  success
  failed
  skipped
}

model AuditLog {
  id              String   @id @default(cuid())
  adminId         String?
  operatorAccount String?  @db.VarChar(50)
  operatorName    String?  @db.VarChar(100)
  action          String   @db.VarChar(100)
  entityType      String   @db.VarChar(50)
  entityId        String?  @db.VarChar(191)
  entityName      String?  @db.VarChar(191)
  detail          String?  @db.LongText
  createdAt       DateTime @default(now())
  admin           Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
}

model WebhookLog {
  id                String           @id @default(cuid())
  scene             String           @db.VarChar(100)
  status            WebhookLogStatus
  title             String?          @db.VarChar(191)
  webhookUrl        String?          @db.VarChar(500)
  messagePreview    String?          @db.LongText
  responseCode      Int?
  errorMessage      String?          @db.VarChar(500)
  relatedEntityType String?          @db.VarChar(50)
  relatedEntityId   String?          @db.VarChar(191)
  createdAt         DateTime         @default(now())

  @@index([createdAt])
  @@index([scene, createdAt])
  @@index([status, createdAt])
}

model LawEntry {
  id               String    @id @default(cuid())
  sourceLawId      Int       @unique
  topCategoryId    Int
  topCategoryTitle String    @db.VarChar(191)
  bookTitle        String?   @db.VarChar(255)
  title            String    @db.VarChar(255)
  pathString       String    @db.VarChar(1000)
  pathTitlesJson   String    @db.LongText
  content          String    @db.LongText
  type             Int       @default(0)
  sourceParentId   Int?
  sourceTopId      Int?
  position         Int       @default(0)
  sourceCreatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([topCategoryId, position])
  @@index([topCategoryTitle])
  @@index([bookTitle])
  @@index([updatedAt])
}

model LawEntryOperation {
  id              String   @id @default(cuid())
  sourceLawId     Int      @unique
  isPublished     Boolean  @default(true)
  isPinned        Boolean  @default(false)
  manualSortOrder Int      @default(0)
  tagsJson        String?  @db.LongText
  operatorNote    String?  @db.LongText
  customTitle     String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, updatedAt])
  @@index([isPinned, manualSortOrder])
}

model LawPracticeQuestion {
  id             String   @id @default(cuid())
  folderId       String?
  title          String   @db.VarChar(191)
  prompt         String   @db.LongText
  lawName        String   @db.VarChar(191)
  articleNo      String   @db.VarChar(100)
  sourceLawId    Int?
  standardText   String   @db.LongText
  explanation    String?  @db.LongText
  tagsJson       String?  @db.LongText
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  folder     LawPracticeQuestionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  paperLinks LawPracticePaperQuestion[]
  answers    LawPracticeAnswer[]

  @@index([folderId])
  @@index([isActive, sortOrder])
  @@index([lawName])
  @@index([sourceLawId])
}

model LawPracticeQuestionFolder {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(191)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions LawPracticeQuestion[]

  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model LawPracticePaper {
  id          String                 @id @default(cuid())
  code        String                 @unique @db.VarChar(64)
  title       String                 @db.VarChar(191)
  description String?                @db.VarChar(500)
  status      LawPracticePaperStatus @default(draft)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  questions LawPracticePaperQuestion[]
  records   LawPracticeRecord[]

  @@index([status, sortOrder])
  @@index([createdAt])
}

model LawPracticePaperQuestion {
  id         String   @id @default(cuid())
  paperId    String
  questionId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  paper    LawPracticePaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question LawPracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([paperId, questionId])
  @@index([paperId, sortOrder])
  @@index([questionId])
}

model LawPracticeRecord {
  id          String               @id @default(cuid())
  userId      String
  paperId     String
  status      MockExamRecordStatus @default(in_progress)
  startedAt   DateTime             @default(now())
  submittedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper   LawPracticePaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  answers LawPracticeAnswer[]

  @@index([userId, updatedAt])
  @@index([paperId, status])
}

model LawPracticeAnswer {
  id         String   @id @default(cuid())
  recordId   String
  questionId String
  articleNo  String?  @db.VarChar(100)
  answerText String?  @db.LongText
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  record   LawPracticeRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  question LawPracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([recordId, questionId])
  @@index([questionId])
}

model DictationSubject {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  color       String   @default("#c9973e") @db.VarChar(32)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters DictationChapter[]

  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model DictationChapter {
  id          String   @id @default(cuid())
  subjectId   String
  title       String   @db.VarChar(191)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject DictationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  items   DictationItem[]

  @@index([subjectId, isActive, sortOrder])
  @@index([createdAt])
}

model DictationItem {
  id            String              @id @default(cuid())
  chapterId     String
  title         String              @db.VarChar(191)
  content       String              @db.LongText
  blanksJson    String              @db.LongText
  source        String?             @db.VarChar(191)
  explanation   String?             @db.LongText
  status        DictationItemStatus @default(published)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  chapter DictationChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, status, sortOrder])
  @@index([createdAt])
}

model RecitationSubject {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  color       String   @default("#c9973e") @db.VarChar(32)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters RecitationChapter[]

  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model RecitationChapter {
  id          String   @id @default(cuid())
  subjectId   String
  title       String   @db.VarChar(191)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject RecitationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  items   RecitationItem[]

  @@index([subjectId, isActive, sortOrder])
  @@index([createdAt])
}

model RecitationItem {
  id          String               @id @default(cuid())
  chapterId   String
  title       String               @db.VarChar(191)
  content     String               @db.LongText
  blanksJson  String               @db.LongText
  source      String?              @db.VarChar(191)
  explanation String?              @db.LongText
  status      RecitationItemStatus @default(published)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  chapter RecitationChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, status, sortOrder])
  @@index([createdAt])
}

model MockExamSeries {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(191)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  papers      MockExamPaper[]
  permissions UserMockExamSeriesPermission[]

  @@index([sortOrder, createdAt])
}

model MockExamPaper {
  id                 String                 @id @default(cuid())
  seriesId           String?
  code               String                 @unique @db.VarChar(64)
  title              String                 @db.VarChar(191)
  subtitle           String?                @db.VarChar(255)
  coverUrl           String?                @db.VarChar(500)
  coverObjectKey     String?                @db.VarChar(255)
  paperType          QuestionBankPaperType?
  year               Int?
  phase              String?                @db.VarChar(50)
  durationMinutes    Int                    @default(180)
  maxAttempts        Int                    @default(0)
  reviewEnabled      Boolean                @default(true)
  reviewAttemptLimit Int                    @default(0)
  permissionRequired Boolean                @default(false)
  totalScore         Int                    @default(0)
  questionCount      Int                    @default(0)
  passScore          Int                    @default(0)
  description        String?                @db.LongText
  status             MockExamPaperStatus    @default(published)
  openTime           DateTime?
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  series             MockExamSeries?            @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  questions          MockExamQuestion[]
  records            MockExamRecord[]
  permissions        UserMockExamPermission[]
