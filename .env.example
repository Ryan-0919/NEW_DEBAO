NODE_ENV=production
PORT=3011

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_ACCOUNT="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
CORS_ORIGIN="https://denlaw.cn,https://www.denlaw.cn"

# Frontend build
VITE_API_BASE_URL=""
VITE_SITE_URL="https://denlaw.cn"
VITE_APP_VERSION="0.0.1"

# OSS upload storage
OSS_REGION="oss-cn-beijing"
OSS_BUCKET="replace-with-bucket"
OSS_ACCESS_KEY_ID="replace-with-ram-access-key-id"
OSS_ACCESS_KEY_SECRET="replace-with-ram-access-key-secret"
OSS_PUBLIC_BASE_URL="https://cdn.example.com"
OSS_SECURE=true
OSS_TIMEOUT_MS=300000
OSS_RETRY_MAX=2
OSS_MULTIPART_PARALLEL=3

# Aliyun SMS verification login
ALIYUN_SMS_ENABLED=true
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_ENDPOINT="dysmsapi.aliyuncs.com"
ALIYUN_SMS_REGION_ID="cn-hangzhou"
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=""
ALIYUN_SMS_CODE_EXPIRES_SECONDS=300
ALIYUN_SMS_SEND_COOLDOWN_SECONDS=60
ALIYUN_SMS_SEND_WINDOW_SECONDS=600
ALIYUN_SMS_SEND_WINDOW_MAX=5
ALIYUN_SMS_VERIFY_MAX_ATTEMPTS=5
ALIYUN_SMS_REQUEST_TIMEOUT_MS=10000

# Media processing
AUDIO_PROCESS_CONCURRENCY=1
AUDIO_PROCESSING_DIR=""
AUDIO_TRANSCODE_ENABLED=true
FFMPEG_PATH=""
FFPROBE_PATH=""

# AI review
MOCK_EXAM_AI_PROVIDER="rules"
MOCK_EXAM_AI_BASE_URL=""
MOCK_EXAM_AI_API_KEY=""
MOCK_EXAM_AI_MODEL=""
MOCK_EXAM_AI_DISABLE_QUEUE=false
MOCK_EXAM_AI_TIMEOUT_MS=120000
MOCK_EXAM_AI_MAX_CONCURRENCY=3
MOCK_EXAM_AI_MAX_RETRY_COUNT=3
MOCK_EXAM_AI_RETRY_DELAY_MS=15000
MOCK_EXAM_AI_RETRY_COOLDOWN_MS=7200000
MOCK_EXAM_AI_QUEUE_POLL_INTERVAL_MS=3000
MOCK_EXAM_AI_MAX_TOKENS=8192
MOCK_EXAM_AI_STRICT_ANSWER_MARK_VALIDATION=true

# Shop / payment
SHOP_PAYMENT_MODE="mock"
SHOP_ORDER_AUTO_CLOSE_MINUTES=30
PAY_SITE_BASE_URL="https://denlaw.cn"
PAY_NOTIFY_BASE_URL="https://denlaw.cn"

# WeChat Pay
WECHAT_PAY_APP_ID=""
WECHAT_PAY_APP_SECRET=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_MCH_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY_PATH=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PLATFORM_CERT_PATH=""
WECHAT_PAY_PLATFORM_CERT=""
WECHAT_PAY_PLATFORM_SERIAL=""
WECHAT_PAY_H5_APP_NAME="得恩法考"
WECHAT_PAY_H5_APP_URL="https://denlaw.cn"

# Alipay
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY_PATH=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY_PATH=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
